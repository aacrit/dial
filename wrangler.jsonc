{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dial",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  // Served at its own subdomain of voidvision.org. The zone's WAF rate-limit
  // rule (contract.yaml zone_waf_rule) was confirmed live on 2026-09-26.
  "routes": [
    { "pattern": "dial.voidvision.org", "custom_domain": true }
  ],
  // workers.dev stays on: the contract's burst_host (dial.aacrit.workers.dev)
  // measures the Worker's own limit there, past the zone's WAF.
  "workers_dev": true,
  // No preview URLs on the production Worker (T11, CoS decision M): each
  // uploaded version would stay public at <version>-dial.aacrit.workers.dev,
  // with whatever guards it had, bound to the production D1. Previews (/ship)
  // run on the separate "preview" environment below instead.
  "preview_urls": false,
  // Worker logs are kept (errors, and anything the Worker itself writes,
  // which is never a request body, IP or key), but invocation logs, one
  // record per request with its URL, headers and client details, are off,
  // and query strings are redacted from what remains (V3; web/privacy.html
  // says so, and tests/privacy-page.test.ts checks both). Traces stay off.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A path that matches no asset gets dist/404.html (web/404.html) with a
    // 404 status from Workers Static Assets, never the Worker (T11, M2): an
    // unknown path costs no invocation. /seal is one of them.
    "not_found_handling": "404-page",
    // Only the Worker's own routes run the Worker: every static page,
    // script, stylesheet and font is served by Workers Static Assets
    // directly, with its headers from dist/_headers (scripts/build.mjs), and
    // costs no Worker invocation (the free plan's 100,000 a day are shared by
    // the whole account). Add a product's API routes here.
    "run_worker_first": ["/e", "/feedback", "/healthz", "/api/*"]
  },
  // Per-client rate limit (worker/src/guard.ts). The binding counts per
  // client network in memory at each Cloudflare location and stores
  // nothing. Periods can only be 10 or 60 seconds. namespace_id must be a
  // number unique across the Cloudflare account: /brief assigns it. Rollbook
  // holds 7201 to 7203; Dial holds 7301 to 7303. RL_EVENTS (POST /e) and
  // RL_FEEDBACK (POST /feedback) are the write paths' own, tighter limits;
  // RL_API is everything else (worker/src/guard.ts limiterFor).
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "7301", "simple": { "limit": 20, "period": 10 } },
    { "name": "RL_EVENTS", "namespace_id": "7302", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_FEEDBACK", "namespace_id": "7303", "simple": { "limit": 2, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dial",
      "database_id": "7888c5fa-08a2-4f2a-85cb-1fcd8b7ce4c0"
    }
  ],
  "vars": {
    "BUILD_TAG": "dev",
    // Day ceilings (worker/src/config.ts). Together their worst case is this
    // product's share of the account's 100,000 D1 writes a day; budget.yaml
    // states it and tests/hardening.test.ts recomputes it from these values.
    "EVENT_DAILY_CEILING": "3500",
    "FEEDBACK_DAILY_CEILING": "100"
  },
  // The preview Worker (T11, CoS decision M): `npx wrangler deploy --env
  // preview` puts a branch at https://dial-preview.aacrit.workers.dev, where
  // /ship runs the contract, bursts included. It shares no binding with
  // production: its own D1 (dial-preview) and its own rate-limit namespaces
  // (7311 to 7313), so unreviewed code never writes to production's data and
  // never shares its counters. Bindings and vars are not inherited from the
  // top level, so each is restated; routes are set empty so the preview can
  // never claim dial.voidvision.org. tests/hardening.test.ts pins all of it.
  "env": {
    "preview": {
      "name": "dial-preview",
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/e", "/feedback", "/healthz", "/api/*"]
      },
      "ratelimits": [
        { "name": "RL_API", "namespace_id": "7311", "simple": { "limit": 20, "period": 10 } },
        { "name": "RL_EVENTS", "namespace_id": "7312", "simple": { "limit": 6, "period": 60 } },
        { "name": "RL_FEEDBACK", "namespace_id": "7313", "simple": { "limit": 2, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dial-preview",
          "database_id": "d80d584d-b7f5-41fb-adae-468fb66b810e"
        }
      ],
      // Small ceilings: the preview's D1 writes count against the same
      // account's 100,000 a day, so it adds a sliver (budget.yaml, summed
      // over every env by tests/hardening.test.ts), enough for the contract
      // and a few manual checks. The bursts write nothing (their bodies are
      // refused), so they pass at any ceiling.
      "vars": {
        "BUILD_TAG": "preview",
        // Every Worker answer on the preview says X-Robots-Tag: noindex
        // (worker/src/index.ts withRobots); static files get it from
        // dist/_headers' rule for this host.
        "ROBOTS": "noindex",
        "EVENT_DAILY_CEILING": "50",
        "FEEDBACK_DAILY_CEILING": "10"
      }
    }
  }
  // Cloudflare caps cron triggers at 5 per account, and this account's one
  // scheduler Worker (see the root CLAUDE.md "API" stack note) already uses
  // its share. This product has no cron trigger of its own: 90-day feedback
  // retention runs in bounded batches before every feedback insert and on
  // each client event's first count of a day (`purgeOldFeedback` in
  // worker/src/index.ts). `event_counts` rows are kept indefinitely: they
  // are aggregate daily totals and identify no one. The `scheduled` handler
  // is still exported so the shared scheduler Worker, or a future dedicated
  // trigger, can run feedback retention deterministically.
  // "triggers": { "crons": ["0 4 * * *"] }
}
